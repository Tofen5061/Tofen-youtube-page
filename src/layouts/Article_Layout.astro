---
import Layout from './Layout.astro';
import Redes from '../components/Redes.astro';
import Icono from '../components/Icono.astro';
import Anuncio from '../components/Anuncio.astro';
import { SUSCRIBIRSE } from '../data/sitio';
import { marked } from 'marked';

interface Props {
	banner_img?: string[];
	banner_alt: string;
	header: string;
	description: string;
	download_link: string;
	after_download_content: string;
	etiqueta?: string;
}

const {
	banner_img = [],
	banner_alt,
	header,
	description,
	download_link,
	after_download_content,
	etiqueta = 'Tutorial',
} = Astro.props;

const htmlDescription = marked.parse(description) as string;
const htmlAfterDownload = marked.parse(after_download_content) as string;

// Descripción para buscadores: primer párrafo sin formato, recortado
const resumen = description
	.split('\n')
	.find((l) => l.trim().length > 0)!
	.replace(/[*_#`>]/g, '')
	.trim()
	.slice(0, 155);
---

<Layout title={`${header} · Tofen`} description={resumen} image={banner_img[0]}>
	<main class="contenedor articulo-pagina">
		<a href="/" class="volver"><Icono nombre="atras" tam={14} /> Volver al inicio</a>

		<div class="rejilla">
			<article class="tarjeta articulo">
				{banner_img.length > 0 && (
					<div id="banner_container" class="banner">
						{banner_img.map((src, index) => (
							<img
								src={src}
								alt={`${banner_alt} ${index + 1}`}
								data-index={index}
								class={index === 0 ? 'active' : ''}
							/>
						))}
					</div>
				)}

				<div class="articulo-cuerpo">
					<span class="eyebrow">{etiqueta}</span>
					<h1 class="articulo-titulo">{header}</h1>

					<div class="prosa" set:html={htmlDescription} />

					<div class="descarga">
						<div class="descarga-texto">
							<strong>Descarga</strong>
							<small>El archivo que uso en el video</small>
						</div>
						<a href={download_link} class="btn btn-principal" target="_blank" rel="noopener">
							<Icono nombre="descargar" />
							Descargar
						</a>
					</div>

					<div class="prosa" set:html={htmlAfterDownload} />
				</div>
			</article>

			<aside class="lateral">
				<div class="tarjeta bloque">
					<span class="bloque-titulo">Sígueme</span>
					<Redes />
				</div>

				<a href={SUSCRIBIRSE} target="_blank" rel="noopener" class="tarjeta bloque aviso">
					<span class="aviso-icono"><Icono nombre="play" tam={18} /></span>
					<span class="aviso-texto">
						<strong>¿Te sirvió?</strong>
						<small>Suscríbete para ver la próxima guía.</small>
					</span>
				</a>

				<div class="lateral-anuncio">
					<Anuncio />
				</div>
			</aside>
		</div>
	</main>
</Layout>

<style>
	.articulo-pagina {
		padding-top: 24px;
	}

	.volver {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 13px;
		font-weight: 600;
		color: var(--texto-2);
		text-decoration: none;
		margin-bottom: 16px;
	}

	.volver:hover {
		color: var(--texto);
	}

	.rejilla {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 300px;
		gap: 24px;
		align-items: start;
	}

	.articulo {
		overflow: hidden;
	}

	/* Carrusel del banner */
	.banner {
		position: relative;
		aspect-ratio: 16 / 9;
		background: var(--bg-sutil);
		border-bottom: 1px solid var(--borde);
		overflow: hidden;
	}

	.banner img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transition: opacity 600ms ease;
	}

	.banner img.active {
		opacity: 1;
	}

	.articulo-cuerpo {
		padding: 28px 32px 36px;
	}

	.articulo-titulo {
		font-size: clamp(22px, 2.6vw, 28px);
		font-weight: 800;
		margin: 6px 0 20px;
	}

	.descarga {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin: 28px 0;
		padding: 16px 20px;
		border: 1px solid var(--durazno-borde);
		background: var(--durazno);
		border-radius: var(--radio-p);
	}

	.descarga-texto {
		display: flex;
		flex-direction: column;
		line-height: 1.35;
	}

	.descarga-texto strong {
		font-size: 14px;
		font-weight: 800;
	}

	.descarga-texto small {
		font-size: 12px;
		color: var(--texto-2);
	}

	.lateral {
		display: flex;
		flex-direction: column;
		gap: 16px;
		position: sticky;
		top: 84px;
	}

	.bloque {
		padding: 16px 20px;
	}

	.bloque-titulo {
		display: block;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--texto-2);
		margin-bottom: 6px;
	}

	.aviso {
		display: flex;
		align-items: center;
		gap: 12px;
		text-decoration: none;
		transition: border-color 150ms;
	}

	.aviso:hover {
		border-color: var(--durazno-borde);
	}

	.aviso-icono {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 10px;
		background: var(--durazno);
		color: var(--naranja-texto);
		flex: none;
	}

	.aviso-texto {
		display: flex;
		flex-direction: column;
		line-height: 1.35;
	}

	.aviso-texto strong {
		font-size: 13px;
	}

	.aviso-texto small {
		font-size: 12px;
		color: var(--texto-2);
	}

	@media (max-width: 900px) {
		.rejilla {
			grid-template-columns: minmax(0, 1fr);
		}
		.lateral {
			position: static;
		}
	}

	@media (max-width: 560px) {
		.articulo-cuerpo {
			padding: 20px 18px 28px;
		}
		.descarga {
			flex-direction: column;
			align-items: stretch;
		}
	}
</style>

<!-- Estilos del texto que viene de Markdown (se generan fuera del componente) -->
<style is:global>
	.prosa {
		font-size: 14px;
		line-height: 1.75;
		color: var(--texto);
	}

	.prosa > * + * {
		margin-top: 14px;
	}

	.prosa h2 {
		font-size: 17px;
		font-weight: 800;
		margin-top: 32px;
	}

	.prosa h3 {
		font-size: 15px;
		font-weight: 800;
		margin-top: 24px;
	}

	.prosa strong {
		font-weight: 800;
	}

	.prosa ul,
	.prosa ol {
		padding-left: 22px;
	}

	.prosa li + li {
		margin-top: 6px;
	}

	.prosa li::marker {
		color: var(--naranja-texto);
		font-weight: 700;
	}

	.prosa a {
		color: var(--naranja-texto);
		font-weight: 700;
	}
</style>

<script>
	import { setupCarousel } from '../scripts/banner_carousel.js';
	setupCarousel();
</script>
