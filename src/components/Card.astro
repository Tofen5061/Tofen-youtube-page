---
import Icono from './Icono.astro';
interface Props {
	titulo: string;
	descripcion: string;
	imagen: string;
	url: string;
	etiqueta: string;
}
const { titulo, descripcion, imagen, url, etiqueta } = Astro.props;
---

<article class="tarjeta card">
	<a href={url} class="card-enlace">
		<div class="miniatura">
			<img src={imagen} alt="" loading="lazy" />
		</div>
		<div class="card-cuerpo">
			<span class="etiqueta">{etiqueta}</span>
			<h2 class="card-titulo">{titulo}</h2>
			<p class="card-desc">{descripcion}</p>
			<span class="card-ver">Ver guía <Icono nombre="flecha" tam={14} /></span>
		</div>
	</a>
</article>

<style>
	.card {
		overflow: hidden;
		transition: border-color 150ms, box-shadow 150ms, transform 150ms;
	}

	.card:hover {
		border-color: var(--durazno-borde);
		box-shadow: var(--sombra-flot);
		transform: translateY(-2px);
	}

	.card-enlace {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}

	.miniatura {
		aspect-ratio: 16 / 9;
		background: var(--bg-sutil);
		border-bottom: 1px solid var(--borde);
		overflow: hidden;
	}

	.miniatura img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.card-cuerpo {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 6px;
		padding: 16px 20px 20px;
		flex: 1;
	}

	.card-titulo {
		font-size: 15px;
		font-weight: 800;
		margin-top: 4px;
	}

	.card-desc {
		font-size: 13px;
		color: var(--texto-2);
	}

	.card-ver {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: auto;
		padding-top: 10px;
		font-size: 13px;
		font-weight: 700;
		color: var(--naranja-texto);
	}
</style>
