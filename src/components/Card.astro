---
import Icono from './Icono.astro';
interface Props {
	titulo: string;
	descripcion: string;
	imagen: string;
	url: string;
	etiqueta: string;
	verGuia?: string;
}
const { titulo, descripcion, imagen, url, etiqueta, verGuia = 'Ver guía' } = Astro.props;
---

<a href={url} class="card video">
	<div class="miniatura">
		<img src={imagen} alt="" loading="lazy" />
	</div>
	<div class="cuerpo">
		<span class="tag">{etiqueta}</span>
		<span class="two">
			<b>{titulo}</b>
			<small>{descripcion}</small>
		</span>
		<span class="ver">{verGuia} <Icono nombre="flecha" /></span>
	</div>
</a>

<style>
	.video {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		color: var(--text);
		transition: border-color 0.15s, box-shadow 0.15s;
	}

	.video:hover {
		text-decoration: none;
		border-color: var(--peach-border);
		box-shadow: var(--shadow-float);
	}

	.miniatura {
		aspect-ratio: 16 / 9;
		background: var(--bg-alt);
		border-bottom: 1px solid var(--border);
		overflow: hidden;
	}

	.miniatura img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.cuerpo {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 12px;
		padding: 20px 24px 22px;
		flex: 1;
	}

	.two b {
		font-size: 17px;
		font-weight: 800;
		letter-spacing: -0.01em;
		line-height: 1.3;
	}

	.two small {
		margin-top: 4px;
		font-size: 14px;
	}

	.ver {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: auto;
		font-size: 14px;
		font-weight: 700;
		color: var(--orange-text);
	}
</style>
