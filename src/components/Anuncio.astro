---
// Bloque de anuncio de AdSense. El script principal se carga una sola vez en Layout.astro.
// En local no se muestra (AdSense solo sirve anuncios en el dominio aprobado).
import { ADSENSE_CLIENTE, ADSENSE_BLOQUE } from '../data/sitio';
interface Props {
	bloque?: string;
}
const { bloque = ADSENSE_BLOQUE } = Astro.props;
const activo = import.meta.env.PROD;
---

{activo && (
<div class="anuncio">
	<span class="anuncio-rotulo">Publicidad</span>
	<ins
		class="adsbygoogle"
		style="display:block"
		data-ad-client={ADSENSE_CLIENTE}
		data-ad-slot={bloque}
		data-ad-format="auto"
		data-full-width-responsive="true"></ins>
	<script is:inline>
		(window.adsbygoogle = window.adsbygoogle || []).push({});
	</script>
</div>
)}

<style>
	/* El anuncio necesita un ancho real para que AdSense pueda llenarlo */
	.anuncio {
		width: 100%;
		min-width: 250px;
	}
	/* El rótulo solo aparece cuando sí llegó un anuncio */
	.anuncio-rotulo {
		display: none;
		font-size: 11px;
		color: var(--faint);
		margin-bottom: 6px;
	}
	.anuncio:has(ins[data-ad-status='filled']) .anuncio-rotulo {
		display: block;
	}
	/* Si AdSense no devuelve anuncio, no dejamos un hueco vacío */
	.anuncio:has(ins[data-ad-status='unfilled']) {
		display: none;
	}
</style>
