---
import Icono from './Icono.astro';
import { REDES } from '../data/sitio';
const anio = new Date().getFullYear();
---

<footer class="pie">
	<div class="contenedor pie-interior">
		<div class="marca">
			<img src="/favicon.svg" alt="" width="18" height="18" />
			<span>© {anio} Tofen · Hecho en Nicaragua</span>
		</div>
		<ul class="redes">
			{REDES.map((r) => (
				<li>
					<a href={r.url} target="_blank" rel="noopener" aria-label={r.nombre} title={r.nombre}>
						<Icono nombre={r.red} />
					</a>
				</li>
			))}
		</ul>
	</div>
</footer>

<style>
	.pie {
		margin-top: 64px;
		border-top: 1px solid var(--borde);
		background: var(--card);
	}

	.pie-interior {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		min-height: 64px;
		flex-wrap: wrap;
		padding-top: 12px;
		padding-bottom: 12px;
	}

	.marca {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 12px;
		color: var(--texto-2);
	}

	.redes {
		display: flex;
		gap: 4px;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.redes a {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 8px;
		color: var(--texto-2);
		transition: background-color 150ms, color 150ms;
	}

	.redes a:hover {
		background: var(--bg-sutil);
		color: var(--naranja-texto);
	}
</style>
