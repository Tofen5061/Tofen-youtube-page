---
import Icono from './Icono.astro';
import { REDES } from '../data/sitio';
const anio = new Date().getFullYear();
---

<footer class="footer">
	<div class="wrap">
		<div class="footer-in">
			<div class="footer-brand">
				<a href="/" class="brand">
					<img src="/marca/tofen-app-icon-oscuro.svg" alt="" width="28" height="28" />
					Tofen
				</a>
				<p class="muted">Tutoriales de programación y tecnología.<br />Hecho en Nicaragua.</p>
			</div>

			<div class="footer-cols">
				<div>
					<p class="foot-title">Sitio</p>
					<a href="/#contenido" class="foot-link">Contenido</a>
					<a href="/#temas" class="foot-link">Temas</a>
					<a href="/about" class="foot-link">Sobre mí</a>
				</div>
				<div>
					<p class="foot-title">Redes</p>
					{REDES.map((r) => (
						<a href={r.url} target="_blank" rel="noopener" class="foot-link">
							<Icono nombre={r.red} />
							{r.nombre}
						</a>
					))}
				</div>
			</div>
		</div>

		<p class="foot-bottom muted">© {anio} Tofen</p>
	</div>
</footer>

<style>
	.footer {
		margin-top: 0;
		border-top: 1px solid var(--border);
		background: var(--bg-alt);
		padding: 48px 0 24px;
	}

	.footer-in {
		display: flex;
		justify-content: space-between;
		gap: 32px;
		flex-wrap: wrap;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--text);
		font-weight: 800;
		font-size: 16px;
	}

	.brand:hover {
		text-decoration: none;
	}

	.brand img {
		border-radius: 7px;
	}

	.footer-brand .muted {
		margin-top: 8px;
	}

	.footer-cols {
		display: flex;
		gap: 56px;
		flex-wrap: wrap;
	}

	.foot-title {
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 10px;
	}

	.foot-link {
		display: flex;
		align-items: center;
		gap: 8px;
		color: var(--text);
		font-size: 14px;
		font-weight: 600;
		padding: 4px 0;
	}

	.foot-link :global(svg) {
		color: var(--muted);
	}

	.foot-link:hover {
		color: var(--orange-text);
		text-decoration: none;
	}

	.foot-bottom {
		margin-top: 32px;
		padding-top: 20px;
		border-top: 1px solid var(--border);
	}

	@media (max-width: 640px) {
		.footer-cols {
			gap: 32px;
		}
	}
</style>
