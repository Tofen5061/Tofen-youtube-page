---
// Íconos de línea finos (trazo 1.5), del tamaño del texto que acompañan.
interface Props {
	nombre: 'youtube' | 'tiktok' | 'instagram' | 'flecha' | 'atras' | 'descargar' | 'play' | 'reloj' | 'mapa' | 'codigo';
	tam?: number;
}
const { nombre, tam = 16 } = Astro.props;
---

<svg
	width={tam}
	height={tam}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{nombre === 'youtube' && (
		<>
			<rect x="2.5" y="5" width="19" height="14" rx="4" />
			<path d="M10 9.2v5.6l4.8-2.8z" />
		</>
	)}
	{nombre === 'tiktok' && (
		<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2.1 4.3 4.8 4.6" />
	)}
	{nombre === 'instagram' && (
		<>
			<rect x="3" y="3" width="18" height="18" rx="5" />
			<circle cx="12" cy="12" r="4" />
			<path d="M17.3 6.7h.01" />
		</>
	)}
	{nombre === 'flecha' && <path d="M5 12h14M13 6l6 6-6 6" />}
	{nombre === 'atras' && <path d="M19 12H5M11 6l-6 6 6 6" />}
	{nombre === 'descargar' && <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />}
	{nombre === 'play' && (
		<>
			<circle cx="12" cy="12" r="9" />
			<path d="M10 8.8v6.4l5.2-3.2z" />
		</>
	)}
	{nombre === 'reloj' && (
		<>
			<circle cx="12" cy="12" r="9" />
			<path d="M12 7v5l3 2" />
		</>
	)}
	{nombre === 'mapa' && (
		<>
			<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" />
			<circle cx="12" cy="10" r="2.3" />
		</>
	)}
	{nombre === 'codigo' && <path d="M8.5 8 4.5 12l4 4M15.5 8l4 4-4 4" />}
</svg>
