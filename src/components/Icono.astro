---
// Íconos de línea finos, del tamaño del texto que acompañan.
interface Props {
	nombre:
		| 'youtube'
		| 'tiktok'
		| 'instagram'
		| 'flecha'
		| 'atras'
		| 'descargar'
		| 'play'
		| 'reloj'
		| 'mapa'
		| 'codigo'
		| 'sol'
		| 'luna'
		| 'check'
		| 'campana'
		| 'monitor'
		| 'celular'
		| 'regla'
		| 'control'
		| 'mas';
	tam?: number;
	trazo?: number;
}
const { nombre, tam = 16, trazo = 1.75 } = Astro.props;
---

<svg
	width={tam}
	height={tam}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={trazo}
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	style="flex:none"
>
	{nombre === 'youtube' && (
		<>
			<rect x="2.5" y="5" width="19" height="14" rx="4" />
			<path d="M10 9.2v5.6l4.8-2.8z" />
		</>
	)}
	{nombre === 'tiktok' && <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2.1 4.3 4.8 4.6" />}
	{nombre === 'instagram' && (
		<>
			<rect x="3" y="3" width="18" height="18" rx="5" />
			<circle cx="12" cy="12" r="4" />
			<path d="M17.3 6.7h.01" />
		</>
	)}
	{nombre === 'flecha' && <path d="M5 12h14M13 6l6 6-6 6" />}
	{nombre === 'atras' && <path d="M19 12H5M11 6l-6 6 6 6" />}
	{nombre === 'descargar' && <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />}
	{nombre === 'play' && (
		<>
			<circle cx="12" cy="12" r="9" />
			<path d="M10 8.8v6.4l5.2-3.2z" />
		</>
	)}
	{nombre === 'reloj' && (
		<>
			<circle cx="12" cy="12" r="9" />
			<path d="M12 7v5l3 2" />
		</>
	)}
	{nombre === 'mapa' && (
		<>
			<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" />
			<circle cx="12" cy="10" r="2.3" />
		</>
	)}
	{nombre === 'codigo' && <path d="M8.5 8 4.5 12l4 4M15.5 8l4 4-4 4" />}
	{nombre === 'sol' && (
		<>
			<circle cx="12" cy="12" r="4" />
			<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
		</>
	)}
	{nombre === 'luna' && <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />}
	{nombre === 'check' && <path d="M5 12.5l4.5 4.5L19 7.5" />}
	{nombre === 'campana' && <path d="M6 9a6 6 0 0 1 12 0c0 6 2.5 7.5 2.5 7.5h-17S6 15 6 9zM10 20a2.2 2.2 0 0 0 4 0" />}
	{nombre === 'monitor' && (
		<>
			<rect x="3" y="4" width="18" height="12" rx="2" />
			<path d="M8 20h8M12 16v4" />
		</>
	)}
	{nombre === 'celular' && (
		<>
			<rect x="6.5" y="2.5" width="11" height="19" rx="2.5" />
			<path d="M11 18.5h2" />
		</>
	)}
	{nombre === 'regla' && <path d="M3 17 17 3l4 4L7 21zM7 13l2 2M10 10l2 2M13 7l2 2" />}
	{nombre === 'control' && (
		<>
			<path d="M7 8h10a4 4 0 0 1 4 4v1a4 4 0 0 1-7 2.6h-4A4 4 0 0 1 3 13v-1a4 4 0 0 1 4-4z" />
			<path d="M8 11v3M6.5 12.5h3M15.5 12h.01M17.5 13.5h.01" />
		</>
	)}
	{nombre === 'mas' && <path d="M12 5v14M5 12h14" />}
</svg>
