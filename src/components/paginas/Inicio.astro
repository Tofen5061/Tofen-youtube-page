---
// Página de inicio, compartida por / (español) y /en/ (inglés)
import Layout from '../../layouts/Layout.astro';
import Card from '../Card.astro';
import Icono from '../Icono.astro';
import Anuncio from '../Anuncio.astro';
import { CONTENIDO, SUSCRIBIRSE } from '../../data/sitio';
import { idiomaDe, textos } from '../../i18n';

const idioma = idiomaDe(Astro.url);
const t = textos(idioma);
const ti = t.inicio;

const iconos = ['codigo', 'regla', 'celular', 'monitor', 'control'] as const;
const temas = (ti.temas as readonly { titulo: string; desc: string }[]).map((tema, i) => ({ ...tema, icono: iconos[i] }));

// Contenido con la descripción y etiqueta del idioma actual
const contenido = CONTENIDO.map((c) => ({
	titulo: c.titulo,
	imagen: c.imagen,
	url: c.url,
	descripcion: idioma === 'en' ? c.descripcion_en : c.descripcion,
	etiqueta: idioma === 'en' ? c.etiqueta_en : c.etiqueta,
}));
const [destacado, ...resto] = contenido;
---

<Layout title={t.meta.titulo}>
	<main>
		<!-- Portada -->
		<section class="hero">
			<div class="wrap hero-in">
				<div class="hero-copy">
					<span class="eyebrow">{ti.eyebrow}</span>
					<h1>{ti.titulo} <span class="accent">{ti.tituloAcento}</span></h1>
					<p class="lead">{ti.bajada}</p>
					<div class="hero-cta">
						<a href={SUSCRIBIRSE} class="btn btn-yt" target="_blank" rel="noopener">
							<Icono nombre="youtube" />
							{ti.suscribete}
						</a>
						<a href="#contenido" class="btn btn-ghost">{ti.verContenido} <Icono nombre="flecha" /></a>
					</div>
					<ul class="hero-points">
						{(ti.puntos as readonly string[]).map((p) => (
							<li><span class="ok"><Icono nombre="check" /></span> {p}</li>
						))}
					</ul>
				</div>

				<!-- Maqueta: tarjeta de video del canal -->
				<div class="hero-art" aria-hidden="true">
					<div class="player">
						<div class="player-thumb">
							<img src={destacado.imagen} alt="" />
							<span class="player-play"><Icono nombre="play" tam={22} trazo={1.5} /></span>
						</div>
						<div class="player-body">
							<div class="player-head">
								<img src="/marca/tofen-app-icon-oscuro.svg" alt="" width="32" height="32" class="player-avatar" />
								<span class="two">
									<b>{destacado.titulo}</b>
									<small>Tofen · {destacado.etiqueta}</small>
								</span>
							</div>
							<p class="player-section">{ti.masDelCanal}</p>
							<div class="player-list">
								{resto.slice(0, 2).map((c) => (
									<div class="player-item">
										<img src={c.imagen} alt="" class="player-mini" />
										<span class="two">
											<b>{c.titulo}</b>
											<small>{c.etiqueta}</small>
										</span>
									</div>
								))}
								<div class="player-item">
									<span class="player-mini vacio"><Icono nombre="mas" /></span>
									<span class="two">
										<b>{ti.proximo}</b>
										<small>{ti.enCamino}</small>
									</span>
								</div>
							</div>
						</div>
					</div>

					<div class="float-card fc-1">
						<span class="fc-ic ic-green"><Icono nombre="campana" /></span>
						<span class="two"><b>{ti.videoNuevo}</b><small>{ti.campanita}</small></span>
					</div>
					<div class="float-card fc-2">
						<span class="fc-ic ic-peach"><Icono nombre="descargar" /></span>
						<span class="two"><b>{ti.descargaLista}</b><small>{ti.enlaceGuia}</small></span>
					</div>
				</div>
			</div>
		</section>

		<!-- Contenido -->
		<section class="section section-alt" id="contenido">
			<div class="wrap">
				<div class="sec-head">
					<span class="eyebrow">{ti.contEyebrow}</span>
					<h2>{ti.contTitulo}</h2>
					<p class="sub">{ti.contSub}</p>
				</div>

				<div class="grid">
					{contenido.map((c) => <Card {...c} verGuia={ti.verGuia} />)}

					<div class="card card-soon">
						<div class="soon-head">
							<span class="ic-box soon-ic"><Icono nombre="mas" tam={18} /></span>
							<span class="two">
								<b>{ti.soonTitulo}</b>
								<small>{ti.soonSub}</small>
							</span>
						</div>
						<p class="soon-text">{ti.soonTexto}</p>
						<a href={SUSCRIBIRSE} target="_blank" rel="noopener" class="soon-link">
							{ti.irCanal} <Icono nombre="flecha" />
						</a>
					</div>
				</div>

				<div class="anuncio-inicio">
					<Anuncio />
				</div>
			</div>
		</section>

		<!-- Temas -->
		<section class="section" id="temas">
			<div class="wrap">
				<div class="sec-head">
					<span class="eyebrow">{ti.temasEyebrow}</span>
					<h2>{ti.temasTitulo}</h2>
					<p class="sub">{ti.temasSub}</p>
				</div>
				<ul class="who">
					{temas.map((t) => (
						<li>
							<span class="ic-box"><Icono nombre={t.icono} tam={18} /></span>
							<span class="two">
								<b>{t.titulo}</b>
								<small>{t.desc}</small>
							</span>
						</li>
					))}
				</ul>
			</div>
		</section>

		<!-- Llamado final -->
		<section class="section final">
			<div class="wrap">
				<div class="cta-end">
					<div>
						<h2>{ti.finalTitulo}</h2>
						<p class="sub">{ti.finalSub}</p>
					</div>
					<a href={SUSCRIBIRSE} class="btn btn-yt" target="_blank" rel="noopener">
						<Icono nombre="youtube" />
						{t.menu.suscribete}
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	/* Portada */
	.hero {
		padding: 64px 0 72px;
		overflow: hidden;
	}

	.hero-in {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 48px;
		align-items: center;
	}

	.hero h1 {
		font-size: clamp(30px, 4.4vw, 46px);
		font-weight: 800;
		letter-spacing: -0.03em;
	}

	.lead {
		margin-top: 18px;
		font-size: 17px;
		color: var(--muted);
		max-width: 34em;
	}

	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 28px;
	}

	.hero-points {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		margin: 22px 0 0;
		padding: 0;
		list-style: none;
	}

	.hero-points li {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 13px;
		font-weight: 600;
		color: var(--muted);
	}

	.ok {
		display: flex;
		color: var(--green);
	}

	/* Maqueta */
	.hero-art {
		position: relative;
		display: flex;
		justify-content: center;
		padding: 12px 0;
	}

	.player {
		width: 340px;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 20px;
		box-shadow: var(--shadow-float);
		overflow: hidden;
	}

	.player-thumb {
		position: relative;
		aspect-ratio: 16 / 9;
		border-bottom: 1px solid var(--border);
	}

	.player-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.player-play {
		position: absolute;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: #0E1016B3;
		color: #fff;
		backdrop-filter: blur(4px);
	}

	.player-body {
		padding: 14px;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.player-head {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.player-avatar {
		border-radius: 50%;
		flex: none;
	}

	.player-head .two b {
		font-size: 13px;
		line-height: 1.3;
	}

	.player-head .two small {
		font-size: 11.5px;
	}

	.player-section {
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
		margin: 6px 2px 0;
	}

	.player-list {
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 2px 10px;
	}

	.player-item {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 8px 0;
	}

	.player-item + .player-item {
		border-top: 1px solid var(--border);
	}

	.player-item .two b {
		font-size: 12.5px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.player-item .two small {
		font-size: 11px;
	}

	.player-mini {
		width: 52px;
		height: 30px;
		border-radius: 6px;
		object-fit: cover;
		flex: none;
	}

	.player-mini.vacio {
		display: grid;
		place-items: center;
		border: 1px dashed var(--border);
		color: var(--muted);
		background: var(--card);
	}

	.float-card {
		position: absolute;
		display: flex;
		align-items: center;
		gap: 10px;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 10px 14px 10px 10px;
		box-shadow: var(--shadow-float);
	}

	.float-card .two b {
		font-size: 12.5px;
	}

	.float-card .two small {
		font-size: 11.5px;
	}

	.fc-1 {
		bottom: -4%;
		left: -4%;
	}

	.fc-2 {
		top: 12%;
		right: -4%;
	}

	.fc-ic {
		width: 32px;
		height: 32px;
		border-radius: 9px;
		display: grid;
		place-items: center;
		flex: none;
	}

	.ic-green {
		background: var(--green-bg);
		color: var(--green);
	}

	.ic-peach {
		background: var(--peach);
		color: var(--orange-text);
	}

	/* Contenido */
	.grid {
		display: grid;
		gap: 16px;
		grid-template-columns: repeat(3, 1fr);
	}

	.card-soon {
		background: transparent;
		border-style: dashed;
		box-shadow: none;
		display: flex;
		flex-direction: column;
		padding: 24px;
	}

	.soon-head {
		display: flex;
		align-items: center;
		gap: 14px;
		padding-bottom: 18px;
		margin-bottom: 16px;
		border-bottom: 1px solid var(--border);
	}

	.soon-head .two b {
		font-size: 17px;
		font-weight: 800;
	}

	.soon-ic {
		background: var(--card);
		border-color: var(--border);
		color: var(--muted);
	}

	.soon-text {
		color: var(--muted);
		font-size: 14px;
	}

	.soon-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: auto;
		padding-top: 16px;
		font-weight: 700;
		font-size: 14px;
	}

	.anuncio-inicio {
		margin-top: 32px;
	}

	/* Temas */
	.who {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 12px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.who li {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 16px;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: var(--r-card);
		box-shadow: var(--shadow);
	}

	/* Llamado final */
	.final {
		padding-top: 0;
	}

	.cta-end {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		flex-wrap: wrap;
		padding: 32px;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 18px;
		box-shadow: var(--shadow);
	}

	.cta-end h2 {
		font-size: clamp(22px, 2.6vw, 28px);
		font-weight: 800;
	}

	/* Tableta */
	@media (max-width: 960px) {
		.hero-in {
			grid-template-columns: 1fr;
			gap: 40px;
		}
		.hero-copy {
			text-align: center;
		}
		.lead {
			margin-left: auto;
			margin-right: auto;
		}
		.hero-cta,
		.hero-points {
			justify-content: center;
		}
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.who {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	/* Celular */
	@media (max-width: 640px) {
		.hero {
			padding: 40px 0 48px;
		}
		.lead {
			font-size: 15.5px;
		}
		.hero-cta {
			flex-direction: column;
		}
		.hero-cta .btn {
			width: 100%;
		}
		.player {
			width: 100%;
			max-width: 320px;
		}
		.float-card {
			display: none;
		}
		.grid {
			grid-template-columns: 1fr;
		}
		.who {
			grid-template-columns: 1fr 1fr;
			gap: 10px;
		}
		.who li {
			flex-direction: column;
			align-items: flex-start;
			gap: 10px;
			padding: 14px;
		}
		.who li:last-child {
			grid-column: span 2;
			flex-direction: row;
			align-items: center;
		}
		.cta-end {
			padding: 24px 20px;
			flex-direction: column;
			align-items: stretch;
			text-align: center;
		}
	}
</style>
