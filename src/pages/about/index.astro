---
import Layout from '../../layouts/Layout.astro';
import Redes from '../../components/Redes.astro';
import Icono from '../../components/Icono.astro';
import { SUSCRIBIRSE } from '../../data/sitio';
---

<Layout
	title="Sobre mí · Tofen"
	description="Soy Kevin Richtofen (Tofen), de Nicaragua. Hago tutoriales de programación y tecnología en YouTube."
>
	<main class="contenedor sobre">
		<section class="tarjeta perfil">
			<img src="/marca/tofen-avatar.svg" alt="" class="avatar" width="72" height="72" />
			<span class="eyebrow">Sobre mí</span>
			<h1>Kevin Richtofen</h1>
			<p class="alias">Tofen</p>

			<ul class="datos">
				<li><Icono nombre="mapa" /> Nicaragua</li>
				<li><Icono nombre="codigo" /> Programación y tecnología</li>
			</ul>

			<p class="bio">
				Subo tutoriales relacionados con la programación y la tecnología y, de vez en cuando, juegos u otros
				temas.
			</p>

			<a href={SUSCRIBIRSE} target="_blank" rel="noopener" class="btn btn-principal">
				<Icono nombre="youtube" />
				Suscríbete al canal
			</a>
		</section>

		<section class="tarjeta redes-tarjeta">
			<span class="bloque-titulo">Redes sociales</span>
			<Redes />
		</section>
	</main>
</Layout>

<style>
	.sobre {
		max-width: 560px;
		padding-top: 48px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.perfil {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 36px 28px 32px;
	}

	.avatar {
		width: 72px;
		height: 72px;
		border-radius: 50%;
		margin-bottom: 16px;
	}

	.perfil h1 {
		font-size: 24px;
		font-weight: 800;
		margin-top: 4px;
	}

	.alias {
		font-size: 13px;
		color: var(--texto-2);
	}

	.datos {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px 20px;
		list-style: none;
		margin: 18px 0 0;
		padding: 0;
	}

	.datos li {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 13px;
		font-weight: 600;
	}

	.datos :global(svg) {
		color: var(--naranja-texto);
	}

	.bio {
		font-size: 14px;
		color: var(--texto-2);
		max-width: 42ch;
		margin: 16px 0 24px;
	}

	.redes-tarjeta {
		padding: 16px 20px;
	}

	.bloque-titulo {
		display: block;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--texto-2);
		margin-bottom: 6px;
	}
</style>
